# Copy this file to .env.local for local development.
# .env.local is gitignored; real secrets never get committed.
# In production, set these in the Vercel dashboard (Settings -> Environment Variables).

# Public site URL used for canonical links, OG tags, sitemap.
# Vercel will override this automatically on deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (add when checkout is wired in — leave blank until then)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Google AdSense (see docs/adsense-setup.md). Everything is OFF by default.
# Set these in Vercel (Settings -> Environment Variables), never in git.
# ---------------------------------------------------------------------------

# Your publisher ID from AdSense (Account -> Settings -> Account information).
# Must be "ca-pub-" followed by 16 digits; anything else is ignored.
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Ownership verification for the AdSense application: off | meta | script
#   meta   = <meta name="google-adsense-account"> on every page
#   script = the AdSense code snippet in <head> on every page (no ads render)
# NEXT_PUBLIC_ADSENSE_VERIFICATION=off

# Master switch for live ads. Only honoured with a valid publisher ID and
# only after AdSense has approved the site. Leave unset until then.
# NEXT_PUBLIC_ADS_ENABLED=false

# Numeric ad-unit ID of a responsive Display ad unit created in AdSense
# (Ads -> By ad unit -> Display ads). Used for all in-article placements.
# NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
